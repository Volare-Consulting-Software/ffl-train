model FlightSearch {
  id                  Int      @id @default(autoincrement())
  airportCode         String
  flightDate          DateTime @db.Date
  flightDistanceMiles Float
  itineraries         Json
  googleFlightsUrl    String?
  raw                 Json
  fetchedAt           DateTime @default(now())

  @@unique([airportCode, flightDate])
  @@map("flight_searches")
}
