model StopTime {
  tripId           String
  sequence         Int
  stationCode      String
  arrivalSeconds   Int
  departureSeconds Int
  distanceMiles    Float
  shapeIndex       Int?
  trip             Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([tripId, sequence])
  @@index([stationCode])
  @@map("stop_times")
}
